# Text source of truth — normalize to CRLF (VBA/VBE convention) and diff as text.
*.bas   text eol=crlf
*.cls   text eol=crlf
*.frm   text eol=crlf
*.vba   text eol=crlf
Word.officeUI text

# Binary artifacts — never munge, never line-diff.
*.frx   binary
*.dotm  binary
*.dotx  binary
*.bin   binary
# Fonts. Git's own heuristic already spots these as binary, but this repo has lost days to a
# line-ending conversion once (the .frm header) and a CRLF-mangled font installs as garbage.
*.otf   binary
*.ttf   binary
