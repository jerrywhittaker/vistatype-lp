# Per-machine build settings (copy from build.config.example).
build.config

# Build outputs and scratch (regenerated by `make build`; deploy promotes to root).
dist/
build/

# Linux read-only mirror produced by `make read` (redundant with src/).
reference/vba-src/

# `make scan` keeps its record of how each build scored here. Deliberately NOT under dist/,
# which `make clean` wipes - it is the only place the comparison with the last build lives.
virustotal-history.tsv

# VistaType LP bundled a typeface derived from Atkinson Hyperlegible from 3.0.101 to 3.0.196.
# It was dropped on 8/20/2026 - no Greek, no IPA, not enough mathematics - and assets/fonts/
# went with it. This rule STAYS anyway: the Braille Institute's license PDF is still on Jerry's
# disk in ~/reference/vistatype-lp/, and a stray second copy landing here must never be tracked.
# It costs nothing and it is the kind of guard that is only missed once.
Atkinson-Hyperlegible-SIL-OPEN-FONT-LICENSE-*.pdf

# Windows "downloaded from the internet" markers, which WSL surfaces as real files.
*:Zone.Identifier

# Python bytecode cache, left behind whenever one tools/lib script imports another.
__pycache__/

# Editor / OS noise.
*~
~$*
.DS_Store
.vscode/
