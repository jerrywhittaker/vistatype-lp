{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/claude-md-sync.py\"",
            "statusMessage": "Checking CLAUDE.md is in sync with build pipeline"
          }
        ]
      }
    ]
  }
}
